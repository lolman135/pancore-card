# Шаблон для nginx:alpine — envsubst підставляє ${BACKEND_PORT} з .env
# і кладе результат у /etc/nginx/conf.d/default.conf при старті контейнера.

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

server {
    listen 80;
    server_name _;

    # DNS Docker: ім'я сервіса бекенда резолвиться в рантаймі, тому nginx
    # піднімається навіть коли бекенд ще не готовий.
    resolver 127.0.0.11 valid=30s;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml application/json;

    # Статика фронта. SPA-роутінгу немає — сторінки це окремі файли.
    location / {
        try_files $uri $uri/ =404;
    }

    # Службові файли репозиторію в роздачу не потрапляють.
    location ~* \.(template|md)$ {
        return 404;
    }

    # Хешів у назвах немає, тож кеш короткий; HTML завжди свіжий.
    location ~* \.(css|js|svg|webp|woff2?)$ {
        expires 1h;
        add_header Cache-Control "public";
    }

    location ~* \.html$ {
        expires -1;
    }

    # ^~ щоб регулярки вище не перехопили API.
    location ^~ /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        # Змінна в proxy_pass → адреса резолвиться на кожен запит (див. resolver).
        # Без URI-частини оригінальний шлях іде до бекенда як є: /api/v1/contact.
        set $backend_url http://backend:${BACKEND_PORT};
        proxy_pass $backend_url;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
