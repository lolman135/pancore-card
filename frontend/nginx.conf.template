limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

server {
    listen 80;
    server_name pancore.eu www.pancore.eu;
    return 301 https://pancore.eu$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name pancore.eu www.pancore.eu;

    ssl_certificate     /etc/letsencrypt/live/pancore.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pancore.eu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    resolver 127.0.0.11 valid=30s;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml application/json;

    location = / {
        return 301 /main;
    }

    location = /index.html {
        return 301 /main;
    }

    location = /index {
        return 301 /main;
    }

    location = /main {
        expires -1;
        try_files /index.html =404;
    }

    location ~ ^/(.+)\.html$ {
        return 301 /$1;
    }

    location ~* \.(template|md)$ {
        return 404;
    }

    location ~* \.(css|js|svg|webp|woff2?)$ {
        add_header Cache-Control "no-cache";
    }

    location / {
        expires -1;
        try_files $uri $uri.html $uri/ =404;
    }

    location ^~ /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        set $backend_url http://backend:${BACKEND_PORT};
        proxy_pass $backend_url;

        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}